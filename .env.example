# Copia este archivo a .env y rellena con los datos de tu proyecto Supabase:
#   cp .env.example .env
#
# Dónde encontrarlos: Supabase → Project Settings → API
#   - Project URL  → VITE_SUPABASE_URL
#   - anon public  → VITE_SUPABASE_ANON_KEY
#
# Admin / barista:
#   1) Supabase → Authentication → Users → Add user (email + password)
#   2) Ejecuta supabase/secure_admin.sql
#   3) Entra en /#admin con ese email y password
#
# PIN solo para modo local (sin Supabase) o respaldo en desarrollo:
# VITE_ADMIN_PIN=tu-pin-secreto

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
VITE_ADMIN_PIN=stamp-demo
