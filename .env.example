# Copia este archivo a .env:
#   cp .env.example .env
#
# Supabase → Project Settings → API
#   Project URL     → VITE_SUPABASE_URL
#   anon / public   → VITE_SUPABASE_ANON_KEY
#
# Setup: ver README.md
# SQL a ejecutar en orden si partes de cero:
#   1) supabase/cuptrack.sql
#   2) supabase/hardening_v2.sql  (si cuptrack ya estaba aplicado antes)

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Pitch / demos (switcher + link Staff). En producción real: false
# En Vercel: true solo mientras demuestres; false para un café en vivo.
VITE_DEMO=false

# Solo modo local (sin Supabase). No usar en producción.
VITE_ADMIN_PIN=cambiar-este-pin
